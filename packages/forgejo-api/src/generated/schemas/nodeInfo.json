        "outbound": {
          "type": "array",
          "items": { "type": "string" },
          "x-go-name": "Outbound"
        }
      },
      "x-go-package": "forgejo.org/modules/structs",
      "x-readme-ref-name": "NodeInfoServices"
    },
    "software": {
