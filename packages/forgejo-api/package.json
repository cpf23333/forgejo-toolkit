{
  "name": "@cpf23333-forgejo-toolkit/api",
  "version": "0.0.1",
  "description": "Generated Forgejo API client from OpenAPI spec",
  "license": "MIT",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./mocks": {
      "types": "./src/mocks/index.ts",
      "default": "./src/mocks/index.ts"
    }
  },
  "scripts": {
    "generate": "kubb generate && node scripts/strip-ts-extensions.js && oxfmt src/generated",
    "check": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "spec:update": "node scripts/update-spec.mjs",
    "generate:safe": "node scripts/generate-safe.mjs"
  },
  "dependencies": {
    "@cpf23333-forgejo-toolkit/shared": "workspace:*"
  },
  "devDependencies": {
    "@kubb/cli": "4.39.2",
    "@kubb/core": "4.39.2",
    "@kubb/plugin-client": "4.39.3",
    "@kubb/plugin-msw": "4.39.2",
    "@kubb/plugin-oas": "4.39.3",
    "@kubb/plugin-ts": "4.39.2",
    "msw": "^2.15.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  }
}
