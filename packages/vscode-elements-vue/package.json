{
  "name": "@forgejo/vscode-elements-vue",
  "version": "0.0.1",
  "description": "Vue 3 adapter for @vscode-elements/elements with Vite plugin and type definitions",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./components": {
      "types": "./src/components/index.d.ts",
      "import": "./src/components/index.ts",
      "require": "./src/components/index.ts"
    },
    "./vite-plugin": {
      "types": "./src/vite-plugin.d.ts",
      "import": "./src/vite-plugin.ts",
      "require": "./src/vite-plugin.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "echo 'No build step required; source is consumed directly via workspace link.'",
    "check": "tsc --noEmit",
    "clean": "rm -rf node_modules dist"
  },
  "dependencies": {
    "@vscode-elements/elements": "^1.14.0"
  },
  "peerDependencies": {
    "@vitejs/plugin-vue": "^5.0.0 || ^6.0.0",
    "vite": "^5.0.0 || ^6.0.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vue": "^3.5.0"
  }
}
