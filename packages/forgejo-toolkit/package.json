{
  "name": "forgejo-toolkit",
  "displayName": "%displayName%",
  "version": "0.2.1",
  "description": "%description%",
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "actions",
    "code review",
    "codeberg",
    "forgejo",
    "git",
    "issues",
    "pull requests",
    "self-hosted"
  ],
  "homepage": "https://codeberg.org/cpf23333/forgejo-toolkit",
  "bugs": {
    "url": "https://codeberg.org/cpf23333/forgejo-toolkit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/cpf23333/forgejo-toolkit.git"
  },
  "publisher": "cpf23333",
  "main": "./out/extension.mjs",
  "scripts": {
    "build": "cross-env FORGEJO_TOOLKIT_PRODUCTION=1 rolldown -c rolldown.config.mjs && vite build --config webview/vite.config.mts",
    "build:extension": "rolldown -c rolldown.config.mjs",
    "build:webview": "vite build --config webview/vite.config.mts",
    "watch:extension": "rolldown -c rolldown.config.mjs --watch",
    "watch:webview": "vite build --config webview/vite.config.mts --watch",
    "dev": "concurrently \"pnpm run watch:extension\" \"pnpm run watch:webview\"",
    "check": "tsc --noEmit && vue-tsc -p webview/tsconfig.json --noEmit",
    "test": "vitest run --config webview/vitest.config.mts && vitest run --config vitest.extension.config.mts",
    "test:webview": "vitest run --config webview/vitest.config.mts",
    "test:extension": "vitest run --config vitest.extension.config.mts",
    "test:watch": "vitest --config webview/vitest.config.mts",
    "clean": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\"",
    "package": "pnpm run build && vsce package --no-dependencies"
  },
  "dependencies": {
    "@cpf23333-forgejo-toolkit/api": "workspace:*",
    "@cpf23333-forgejo-toolkit/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@vscode/codicons": "0.0.46-24",
    "dompurify": "^3.4.16",
    "easymde": "^2.21.0",
    "tributejs": "^5.1.3",
    "undici": "^8.11.2",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1",
    "yaml": "2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/vscode": "~1.102.0",
    "@types/vscode-webview": "^1.57.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vscode-elements/elements": "^2.5.1",
    "@vscode/vsce": "^4.0.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "happy-dom": "20.14.5",
    "jsdom": "30.0.1",
    "lightningcss": "^1.33.0",
    "msw": "^2.15.0",
    "rolldown": "~1.2.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "l10n": "./l10n",
  "contributes": {
    "configuration": {
      "title": "Forgejo Toolkit",
      "properties": {
        "forgejoToolkit.locale": {
          "type": "string",
          "enum": [
            "en",
            "zh"
          ],
          "description": "%config.locale.description%"
        },
        "forgejoToolkit.debug": {
          "type": "boolean",
          "default": false,
          "description": "%config.debug.description%"
        },
        "forgejoToolkit.worktreeOpenMode": {
          "type": "string",
          "default": "ask",
          "enum": [
            "ask",
            "newWindow",
            "currentWindow"
          ],
          "enumDescriptions": [
            "%config.worktreeOpenMode.enumDescriptions.ask%",
            "%config.worktreeOpenMode.enumDescriptions.newWindow%",
            "%config.worktreeOpenMode.enumDescriptions.currentWindow%"
          ],
          "description": "%config.worktreeOpenMode.description%"
        },
        "forgejoToolkit.worktreeCacheDirectory": {
          "type": "string",
          "default": "",
          "description": "%config.worktreeCacheDirectory.description%"
        },
        "forgejoToolkit.notificationPollingEnabled": {
          "type": "boolean",
          "default": true,
          "title": "%config.notificationPollingEnabled.title%",
          "description": "%config.notificationPollingEnabled.description%"
        },
        "forgejoToolkit.notificationPollingInterval": {
          "type": "number",
          "default": 300,
          "minimum": 60,
          "maximum": 3600,
          "title": "%config.notificationPollingInterval.title%",
          "description": "%config.notificationPollingInterval.description%"
        },
        "forgejoToolkit.useMockApi": {
          "type": "boolean",
          "default": false,
          "title": "%config.useMockApi.title%",
          "description": "%config.useMockApi.description%"
        },
        "forgejoToolkit.mcpEnabled": {
          "type": "boolean",
          "default": true,
          "title": "%config.mcpEnabled.title%",
          "description": "%config.mcpEnabled.description%"
        },
        "forgejoToolkit.mcpWriteTools.createIssueComment": {
          "type": "boolean",
          "default": false,
          "title": "%config.mcpWriteTools.createIssueComment.title%",
          "description": "%config.mcpWriteTools.createIssueComment.description%"
        },
        "forgejoToolkit.mcpWriteTools.submitPullReview": {
          "type": "boolean",
          "default": false,
          "title": "%config.mcpWriteTools.submitPullReview.title%",
          "description": "%config.mcpWriteTools.submitPullReview.description%"
        },
        "forgejoToolkit.mcpWriteTools.cancelActionRun": {
          "type": "boolean",
          "default": false,
          "title": "%config.mcpWriteTools.cancelActionRun.title%",
          "description": "%config.mcpWriteTools.cancelActionRun.description%"
        },
        "forgejoToolkit.mcpWriteAuditToFile": {
          "type": "boolean",
          "default": false,
          "title": "%config.mcpWriteAuditToFile.title%",
          "description": "%config.mcpWriteAuditToFile.description%"
        },
        "forgejoToolkit.multiWindowLease": {
          "type": "boolean",
          "default": true,
          "title": "%config.multiWindowLease.title%",
          "description": "%config.multiWindowLease.description%"
        },
        "forgejoToolkit.aiEnabled": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "title": "%config.aiEnabled.title%",
          "description": "%config.aiEnabled.description%"
        },
        "forgejoToolkit.aiPreReview": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "title": "%config.aiPreReview.title%",
          "description": "%config.aiPreReview.description%"
        },
        "forgejoToolkit.aiPreReviewPromptScope": {
          "type": "string",
          "default": "ask",
          "scope": "machine",
          "enum": [
            "ask",
            "metadata-only",
            "changed-lines-only",
            "full-diff",
            "changed-files"
          ],
          "enumDescriptions": [
            "%config.aiPreReviewPromptScope.enumDescriptions.ask%",
            "%config.aiPreReviewPromptScope.enumDescriptions.metadataOnly%",
            "%config.aiPreReviewPromptScope.enumDescriptions.changedLinesOnly%",
            "%config.aiPreReviewPromptScope.enumDescriptions.fullDiff%",
            "%config.aiPreReviewPromptScope.enumDescriptions.changedFiles%"
          ],
          "title": "%config.aiPreReviewPromptScope.title%",
          "description": "%config.aiPreReviewPromptScope.description%"
        },
        "forgejoToolkit.aiPreReviewModel": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "title": "%config.aiPreReviewModel.title%",
          "description": "%config.aiPreReviewModel.description%"
        },
        "forgejoToolkit.prDescription": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "title": "%config.prDescription.title%",
          "description": "%config.prDescription.description%"
        },
        "forgejoToolkit.prDescriptionPromptScope": {
          "type": "string",
          "default": "ask",
          "scope": "machine",
          "enum": [
            "ask",
            "commits-only",
            "commits-and-diff",
            "commits-and-files"
          ],
          "enumDescriptions": [
            "%config.prDescriptionPromptScope.enumDescriptions.ask%",
            "%config.prDescriptionPromptScope.enumDescriptions.commitsOnly%",
            "%config.prDescriptionPromptScope.enumDescriptions.commitsAndDiff%",
            "%config.prDescriptionPromptScope.enumDescriptions.commitsAndFiles%"
          ],
          "title": "%config.prDescriptionPromptScope.title%",
          "description": "%config.prDescriptionPromptScope.description%"
        },
        "forgejoToolkit.issueTriage": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "title": "%config.issueTriage.title%",
          "description": "%config.issueTriage.description%"
        },
        "forgejoToolkit.issueTriagePromptScope": {
          "type": "string",
          "default": "ask",
          "scope": "machine",
          "enum": [
            "ask",
            "issue-only",
            "issue-and-comments"
          ],
          "enumDescriptions": [
            "%config.issueTriagePromptScope.enumDescriptions.ask%",
            "%config.issueTriagePromptScope.enumDescriptions.issueOnly%",
            "%config.issueTriagePromptScope.enumDescriptions.issueAndComments%"
          ],
          "title": "%config.issueTriagePromptScope.title%",
          "description": "%config.issueTriagePromptScope.description%"
        },
        "forgejoToolkit.aiProviders": {
          "type": "array",
          "default": [],
          "scope": "machine",
          "title": "%config.aiProviders.title%",
          "description": "%config.aiProviders.description%",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "baseUrl"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "%config.aiProviders.item.id%"
              },
              "name": {
                "type": "string",
                "description": "%config.aiProviders.item.name%"
              },
              "baseUrl": {
                "type": "string",
                "description": "%config.aiProviders.item.baseUrl%"
              },
              "auth": {
                "type": "string",
                "enum": [
                  "bearer",
                  "api-key-header",
                  "none"
                ],
                "default": "bearer",
                "description": "%config.aiProviders.item.auth%"
              },
              "models": {
                "type": "array",
                "default": [],
                "description": "%config.aiProviders.item.models%",
                "items": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                }
              },
              "headers": {
                "type": "array",
                "default": [],
                "description": "%config.aiProviders.item.headers%",
                "items": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "forgejoToolkit.aiTransport": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "vscode-lm",
            "openai-compatible"
          ],
          "enumDescriptions": [
            "%config.aiTransport.enumDescriptions.auto%",
            "%config.aiTransport.enumDescriptions.vscodeLm%",
            "%config.aiTransport.enumDescriptions.openAiCompatible%"
          ],
          "scope": "machine",
          "title": "%config.aiTransport.title%",
          "description": "%config.aiTransport.description%"
        },
        "forgejoToolkit.aiDefaultProvider": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "title": "%config.aiDefaultProvider.title%",
          "description": "%config.aiDefaultProvider.description%"
        },
        "forgejoToolkit.aiDefaultModel": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "title": "%config.aiDefaultModel.title%",
          "description": "%config.aiDefaultModel.description%"
        },
        "forgejoToolkit.aiModelBindings": {
          "type": "array",
          "default": [],
          "scope": "machine",
          "title": "%config.aiModelBindings.title%",
          "description": "%config.aiModelBindings.description%",
          "items": {
            "type": "object",
            "required": [
              "feature",
              "providerId",
              "modelId"
            ],
            "properties": {
              "feature": {
                "type": "string",
                "enum": [
                  "aiPreReview",
                  "prDescription"
                ],
                "description": "%config.aiModelBindings.item.feature%"
              },
              "providerId": {
                "type": "string",
                "description": "%config.aiModelBindings.item.providerId%"
              },
              "modelId": {
                "type": "string",
                "description": "%config.aiModelBindings.item.modelId%"
              }
            }
          }
        },
        "forgejoToolkit.aiModelRequestTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "maximum": 600000,
          "scope": "machine",
          "title": "%config.aiModelRequestTimeoutMs.title%",
          "description": "%config.aiModelRequestTimeoutMs.description%"
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "forgejo-toolkit.instances",
        "label": "%mcpServerDefinitionProvider.instances.label%"
      }
    ],
    "commands": [
      {
        "command": "forgejoToolkit.openDashboard",
        "title": "%command.openDashboard.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(home)"
      },
      {
        "command": "forgejoToolkit.openOnboarding",
        "title": "%command.openOnboarding.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(book)"
      },
      {
        "command": "forgejoToolkit.openSettings",
        "title": "%command.openSettings.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(gear)"
      },
      {
        "command": "forgejoToolkit.openNativeSettings",
        "title": "%command.openNativeSettings.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(settings-gear)"
      },
      {
        "command": "forgejoToolkit.refreshInstances",
        "title": "%command.refreshInstances.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(refresh)"
      },
      {
        "command": "forgejoToolkit.refreshRepository",
        "title": "%command.refreshRepository.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(refresh)"
      },
      {
        "command": "forgejoToolkit.refreshIssue",
        "title": "%command.refreshIssue.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(refresh)"
      },
      {
        "command": "forgejoToolkit.refreshPullRequest",
        "title": "%command.refreshPullRequest.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(refresh)"
      },
      {
        "command": "forgejoToolkit.refreshNotifications",
        "title": "%command.refreshNotifications.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(refresh)"
      },
      {
        "command": "forgejoToolkit.copyPermalink",
        "title": "%command.copyPermalink.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(link)"
      },
      {
        "command": "forgejoToolkit.publishToForgejo",
        "title": "%command.publishToForgejo.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "forgejoToolkit.showLog",
        "title": "%command.showLog.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(output)"
      },
      {
        "command": "forgejoToolkit.createPrFromCurrentBranch",
        "title": "%command.createPrFromCurrentBranch.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(git-pull-request-create)"
      },
      {
        "command": "forgejoToolkit.deletePullReviewComment",
        "title": "%command.deletePullReviewComment.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(trash)"
      },
      {
        "command": "forgejoToolkit.addPullReviewComment",
        "title": "%command.addPullReviewComment.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(comment)"
      },
      {
        "command": "forgejoToolkit.replyToPullReviewComment",
        "title": "%command.replyToPullReviewComment.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(reply)"
      },
      {
        "command": "forgejoToolkit.aiPreReviewPullRequest",
        "title": "%command.aiPreReviewPullRequest.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(sparkle)"
      },
      {
        "command": "forgejoToolkit.aiPreReviewChooseModel",
        "title": "%command.aiPreReviewChooseModel.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(checklist)"
      },
      {
        "command": "forgejoToolkit.aiPreReviewProbeChatModels",
        "title": "%command.aiPreReviewProbeChatModels.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(beaker)"
      },
      {
        "command": "forgejoToolkit.aiPreReviewOpenDiagnostics",
        "title": "%command.aiPreReviewOpenDiagnostics.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(output)"
      },
      {
        "command": "forgejoToolkit.aiTestProvider",
        "title": "%command.aiTestProvider.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(plug)"
      },
      {
        "command": "forgejoToolkit.generatePrDescription",
        "title": "%command.generatePrDescription.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(sparkle)"
      },
      {
        "command": "forgejoToolkit.copyAgentsWindowMcpConfig",
        "title": "%command.copyAgentsWindowMcpConfig.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(copy)"
      },
      {
        "command": "forgejoToolkit.writeCopilotInstructions",
        "title": "%command.writeCopilotInstructions.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(copilot)"
      },
      {
        "command": "forgejoToolkit.copyPollingDiagnostics",
        "title": "%command.copyPollingDiagnostics.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(copy)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forgejoToolkit",
          "title": "Forgejo Toolkit",
          "icon": "$(repo)"
        }
      ]
    },
    "views": {
      "forgejoToolkit": [
        {
          "type": "webview",
          "id": "forgejoToolkitView",
          "name": "%view.dashboard.name%",
          "icon": "$(repo)",
          "when": "true"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "forgejoToolkit.gettingStarted",
        "title": "%walkthrough.gettingStarted.title%",
        "description": "%walkthrough.gettingStarted.description%",
        "steps": [
          {
            "id": "addInstance",
            "title": "%walkthrough.addInstance.title%",
            "description": "%walkthrough.addInstance.description%",
            "media": {
              "markdown": "./walkthrough/addInstance.md"
            }
          },
          {
            "id": "openDashboard",
            "title": "%walkthrough.openDashboard.title%",
            "description": "%walkthrough.openDashboard.description%",
            "media": {
              "markdown": "./walkthrough/openDashboard.md"
            }
          },
          {
            "id": "publishOrCreatePr",
            "title": "%walkthrough.publishOrCreatePr.title%",
            "description": "%walkthrough.publishOrCreatePr.description%",
            "media": {
              "markdown": "./walkthrough/publishOrCreatePr.md"
            }
          }
        ]
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "forgejoToolkit.deletePullReviewComment",
          "when": "false"
        },
        {
          "command": "forgejoToolkit.addPullReviewComment",
          "when": "false"
        },
        {
          "command": "forgejoToolkit.replyToPullReviewComment",
          "when": "false"
        },
        {
          "command": "forgejoToolkit.aiPreReviewPullRequest",
          "when": "false"
        },
        {
          "command": "forgejoToolkit.aiPreReviewProbeChatModels",
          "when": "config.forgejoToolkit.debug && config.forgejoToolkit.aiPreReview"
        },
        {
          "command": "forgejoToolkit.refreshInstances",
          "when": "forgejoToolkit.activeView == dashboard"
        },
        {
          "command": "forgejoToolkit.refreshRepository",
          "when": "forgejoToolkit.activeView =~ /^(repoDetail|repoIssues|repoPullRequests|actionRunDetail)$/"
        },
        {
          "command": "forgejoToolkit.refreshIssue",
          "when": "forgejoToolkit.activeView == issueDetail"
        },
        {
          "command": "forgejoToolkit.refreshPullRequest",
          "when": "forgejoToolkit.activeView == pullRequestDetail"
        },
        {
          "command": "forgejoToolkit.refreshNotifications",
          "when": "forgejoToolkit.activeView == notifications"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "forgejoToolkit.replyToPullReviewComment",
          "when": "commentController == forgejo-pull-review-comments",
          "group": "inline@0"
        }
      ],
      "comments/comment/context": [
        {
          "command": "forgejoToolkit.deletePullReviewComment",
          "when": "commentController == forgejo-pull-review-comments && comment =~ /^forgejo:/",
          "group": "navigation@0"
        }
      ],
      "editor/context": [
        {
          "command": "forgejoToolkit.copyPermalink",
          "when": "resourceScheme == forgejo-pr || (resourceScheme == file && forgejoToolkit.hasLinkedRepo)",
          "group": "9_cutcopypaste@5"
        },
        {
          "command": "forgejoToolkit.addPullReviewComment",
          "when": "forgejoToolkit.inPullRequestDiff",
          "group": "1_comments@0"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "forgejoToolkit.addPullReviewComment",
          "when": "forgejoToolkit.inPullRequestDiff",
          "group": "comments@0"
        }
      ],
      "editor/title": [
        {
          "command": "forgejoToolkit.aiPreReviewPullRequest",
          "when": "forgejoToolkit.inPullRequestDiff && config.forgejoToolkit.aiPreReview",
          "group": "navigation@0"
        }
      ],
      "view/title": [
        {
          "command": "forgejoToolkit.openDashboard",
          "when": "view == forgejoToolkitView",
          "group": "navigation@0"
        },
        {
          "command": "forgejoToolkit.openOnboarding",
          "when": "view == forgejoToolkitView",
          "group": "navigation@1"
        },
        {
          "command": "forgejoToolkit.openSettings",
          "when": "view == forgejoToolkitView",
          "group": "navigation@2"
        },
        {
          "command": "forgejoToolkit.refreshInstances",
          "when": "view == forgejoToolkitView && forgejoToolkit.activeView == dashboard",
          "group": "navigation@3"
        },
        {
          "command": "forgejoToolkit.refreshRepository",
          "when": "view == forgejoToolkitView && forgejoToolkit.activeView =~ /^(repoDetail|repoIssues|repoPullRequests|actionRunDetail)$/",
          "group": "navigation@3"
        },
        {
          "command": "forgejoToolkit.refreshIssue",
          "when": "view == forgejoToolkitView && forgejoToolkit.activeView == issueDetail",
          "group": "navigation@3"
        },
        {
          "command": "forgejoToolkit.refreshPullRequest",
          "when": "view == forgejoToolkitView && forgejoToolkit.activeView == pullRequestDetail",
          "group": "navigation@3"
        },
        {
          "command": "forgejoToolkit.refreshNotifications",
          "when": "view == forgejoToolkitView && forgejoToolkit.activeView == notifications",
          "group": "navigation@3"
        }
      ],
      "scm/title": [
        {
          "command": "forgejoToolkit.publishToForgejo",
          "when": "scmProvider == git && forgejoToolkit.hasUnpublishedRepo",
          "group": "navigation@1"
        },
        {
          "command": "forgejoToolkit.createPrFromCurrentBranch",
          "when": "scmProvider == git && forgejoToolkit.hasLinkedRepo",
          "group": "navigation@2"
        }
      ]
    }
  },
  "activationEvents": [
    "onFileSystem:cpf23333-forgejo-toolkit-repofile",
    "onFileSystem:forgejo-pr",
    "onStartupFinished"
  ],
  "engines": {
    "vscode": "^1.102.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces.description%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces.description%"
    }
  }
}
