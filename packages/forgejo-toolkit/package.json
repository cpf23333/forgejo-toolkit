{
  "name": "forgejo-toolkit",
  "displayName": "Forgejo Toolkit",
  "description": "A VS Code extension for Forgejo",
  "version": "0.0.1",
  "publisher": "your-publisher-name",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "forgejo",
    "gitea",
    "git",
    "issues",
    "pull requests"
  ],
  "activationEvents": [
    "onCommand:forgejoToolkit.addInstance",
    "onCommand:forgejoToolkit.openDashboard",
    "onView:forgejoToolkitInstances"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "forgejoToolkit.addInstance",
        "title": "Add Instance",
        "category": "Forgejo Toolkit"
      },
      {
        "command": "forgejoToolkit.removeInstance",
        "title": "Remove Instance",
        "category": "Forgejo Toolkit"
      },
      {
        "command": "forgejoToolkit.openDashboard",
        "title": "Open Dashboard",
        "category": "Forgejo Toolkit"
      },
      {
        "command": "forgejoToolkit.refreshInstances",
        "title": "Refresh Instances",
        "category": "Forgejo Toolkit",
        "icon": "$(refresh)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "forgejoToolkitInstances",
          "name": "Forgejo Toolkit",
          "when": "true"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "forgejoToolkit.addInstance",
          "when": "view == forgejoToolkitInstances",
          "group": "navigation@1"
        },
        {
          "command": "forgejoToolkit.refreshInstances",
          "when": "view == forgejoToolkitInstances",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "forgejoToolkit.removeInstance",
          "when": "view == forgejoToolkitInstances && viewItem == forgejoInstance",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js && vite build --config webview/vite.config.ts",
    "build:extension": "node esbuild.js",
    "build:webview": "vite build --config webview/vite.config.ts",
    "watch:extension": "node esbuild.js --watch",
    "watch:webview": "vite build --config webview/vite.config.ts --watch",
    "check": "tsc --noEmit && tsc -p webview/tsconfig.json --noEmit",
    "clean": "rm -rf out node_modules",
    "vscode:prepublish": "pnpm run build",
    "package": "vsce package"
  },
  "dependencies": {
    "@forgejo/vscode-elements-vue": "workspace:*",
    "@vscode-elements/elements": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@types/vscode-webview": "^1.57.5",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vue": "^3.5.0"
  }
}
