{
  "name": "forgejo-toolkit",
  "displayName": "Forgejo Toolkit",
  "version": "0.0.1",
  "description": "A VS Code extension for Forgejo",
  "categories": [
    "Other"
  ],
  "keywords": [
    "forgejo",
    "git",
    "gitea",
    "issues",
    "pull requests"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "http://192.168.1.100:3004/cpf23333/forgejo-toolkit.git"
  },
  "publisher": "your-publisher-name",
  "main": "./out/extension.js",
  "scripts": {
    "build": "node esbuild.js --production && vite build --config webview/vite.config.ts",
    "build:extension": "node esbuild.js",
    "build:webview": "vite build --config webview/vite.config.ts",
    "watch:extension": "node esbuild.js --watch",
    "watch:webview": "vite build --config webview/vite.config.ts --watch",
    "dev": "concurrently \"pnpm run watch:extension\" \"pnpm run watch:webview\"",
    "check": "tsc --noEmit && vue-tsc -p webview/tsconfig.json --noEmit",
    "test": "vitest run --config webview/vitest.config.ts",
    "test:watch": "vitest --config webview/vitest.config.ts",
    "clean": "rm -rf out node_modules",
    "package": "pnpm run build && vsce package --no-dependencies"
  },
  "dependencies": {
    "@cpf23333-forgejo-toolkit/api": "workspace:*",
    "@cpf23333-forgejo-toolkit/shared": "workspace:*",
    "@cpf23333-forgejo-toolkit/vscode-elements-vue": "workspace:*",
    "easymde": "^2.21.0",
    "font-awesome": "^4.7.0",
    "vue-i18n": "^10.0.7",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/vscode": "^1.85.0",
    "@types/vscode-webview": "^1.57.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vscode-elements/elements": "^2.5.1",
    "@vscode/codicons": "^0.0.45",
    "@vscode/vsce": "^3.3.2",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.32.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.5"
  },
  "l10n": "./l10n",
  "contributes": {
    "configuration": {
      "title": "Forgejo Toolkit",
      "properties": {
        "forgejoToolkit.locale": {
          "type": "string",
          "default": "zh",
          "enum": [
            "en",
            "zh"
          ],
          "description": "Display language for the Forgejo Toolkit panel"
        },
        "forgejoToolkit.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging to the Forgejo Toolkit output channel"
        },
        "forgejoToolkit.worktreeOpenMode": {
          "type": "string",
          "default": "ask",
          "enum": [
            "ask",
            "newWindow",
            "currentWindow"
          ],
          "enumDescriptions": [
            "Ask each time how to open a worktree",
            "Open worktrees in a new VS Code window",
            "Open worktrees in the current VS Code window"
          ],
          "description": "How to open a PR worktree after it is created"
        },
        "forgejoToolkit.worktreeCacheDirectory": {
          "type": "string",
          "default": "",
          "description": "Custom parent directory for PR worktrees. Leave empty to use the default extension storage location."
        }
      }
    },
    "commands": [
      {
        "command": "forgejoToolkit.openDashboard",
        "title": "Open Dashboard",
        "category": "Forgejo Toolkit",
        "icon": "$(home)"
      },
      {
        "command": "forgejoToolkit.openOnboarding",
        "title": "Open Setup Guide",
        "category": "Forgejo Toolkit",
        "icon": "$(book)"
      },
      {
        "command": "forgejoToolkit.openSettings",
        "title": "Open Settings",
        "category": "Forgejo Toolkit",
        "icon": "$(gear)"
      },
      {
        "command": "forgejoToolkit.refreshInstances",
        "title": "Refresh Instances",
        "category": "Forgejo Toolkit",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forgejoToolkit",
          "title": "Forgejo Toolkit",
          "icon": "$(repo)"
        }
      ]
    },
    "views": {
      "forgejoToolkit": [
        {
          "type": "webview",
          "id": "forgejoToolkitView",
          "name": "Dashboard",
          "icon": "$(repo)",
          "when": "true"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "forgejoToolkit.openDashboard",
          "when": "false"
        },
        {
          "command": "forgejoToolkit.openOnboarding",
          "when": "false"
        },
        {
          "command": "forgejoToolkit.openSettings",
          "when": "false"
        },
        {
          "command": "forgejoToolkit.refreshInstances",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "forgejoToolkit.openDashboard",
          "when": "view == forgejoToolkitView",
          "group": "navigation@0"
        },
        {
          "command": "forgejoToolkit.openOnboarding",
          "when": "view == forgejoToolkitView",
          "group": "navigation@1"
        },
        {
          "command": "forgejoToolkit.openSettings",
          "when": "view == forgejoToolkitView",
          "group": "navigation@2"
        },
        {
          "command": "forgejoToolkit.refreshInstances",
          "when": "view == forgejoToolkitView",
          "group": "navigation@3"
        }
      ]
    }
  },
  "activationEvents": [
    "onView:forgejoToolkitView"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "packageManager": "pnpm@11.18.0"
}
