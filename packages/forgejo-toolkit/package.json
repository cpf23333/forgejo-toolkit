{
  "name": "forgejo-toolkit",
  "displayName": "%displayName%",
  "version": "0.0.1",
  "description": "%description%",
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "forgejo",
    "git",
    "gitea",
    "issues",
    "pull requests"
  ],
  "homepage": "https://codeberg.org/cpf23333/forgejo-toolkit",
  "bugs": {
    "url": "https://codeberg.org/cpf23333/forgejo-toolkit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/cpf23333/forgejo-toolkit.git"
  },
  "publisher": "cpf23333",
  "main": "./out/extension.mjs",
  "scripts": {
    "build": "node esbuild.js --production && vite build --config webview/vite.config.mts",
    "build:extension": "node esbuild.js",
    "build:webview": "vite build --config webview/vite.config.mts",
    "watch:extension": "node esbuild.js --watch",
    "watch:webview": "vite build --config webview/vite.config.mts --watch",
    "dev": "concurrently \"pnpm run watch:extension\" \"pnpm run watch:webview\"",
    "check": "tsc --noEmit && vue-tsc -p webview/tsconfig.json --noEmit",
    "test": "vitest run --config webview/vitest.config.mts && vitest run --config vitest.extension.config.mts",
    "test:webview": "vitest run --config webview/vitest.config.mts",
    "test:extension": "vitest run --config vitest.extension.config.mts",
    "test:watch": "vitest --config webview/vitest.config.mts",
    "clean": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\"",
    "package": "pnpm run build && vsce package --no-dependencies"
  },
  "dependencies": {
    "@cpf23333-forgejo-toolkit/api": "workspace:*",
    "@cpf23333-forgejo-toolkit/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@vscode/codicons": "0.0.46-24",
    "dompurify": "^3.4.16",
    "easymde": "^2.21.0",
    "tributejs": "^5.1.3",
    "undici": "^8.11.2",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1",
    "yaml": "2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/vscode": "~1.102.0",
    "@types/vscode-webview": "^1.57.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vscode-elements/elements": "^2.5.1",
    "@vscode/vsce": "^4.0.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "jsdom": "30.0.1",
    "lightningcss": "^1.33.0",
    "msw": "^2.15.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "l10n": "./l10n",
  "contributes": {
    "configuration": {
      "title": "Forgejo Toolkit",
      "properties": {
        "forgejoToolkit.locale": {
          "type": "string",
          "enum": [
            "en",
            "zh"
          ],
          "description": "%config.locale.description%"
        },
        "forgejoToolkit.debug": {
          "type": "boolean",
          "default": false,
          "description": "%config.debug.description%"
        },
        "forgejoToolkit.worktreeOpenMode": {
          "type": "string",
          "default": "ask",
          "enum": [
            "ask",
            "newWindow",
            "currentWindow"
          ],
          "enumDescriptions": [
            "%config.worktreeOpenMode.enumDescriptions.ask%",
            "%config.worktreeOpenMode.enumDescriptions.newWindow%",
            "%config.worktreeOpenMode.enumDescriptions.currentWindow%"
          ],
          "description": "%config.worktreeOpenMode.description%"
        },
        "forgejoToolkit.worktreeCacheDirectory": {
          "type": "string",
          "default": "",
          "description": "%config.worktreeCacheDirectory.description%"
        },
        "forgejoToolkit.notificationPollingEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.notificationPollingEnabled.description%"
        },
        "forgejoToolkit.notificationPollingInterval": {
          "type": "number",
          "default": 300,
          "minimum": 60,
          "maximum": 3600,
          "description": "%config.notificationPollingInterval.description%"
        },
        "forgejoToolkit.useMockApi": {
          "type": "boolean",
          "default": false,
          "description": "%config.useMockApi.description%"
        },
        "forgejoToolkit.mcpEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.mcpEnabled.description%"
        },
        "forgejoToolkit.mcpWriteTools.createIssueComment": {
          "type": "boolean",
          "default": false,
          "description": "%config.mcpWriteTools.createIssueComment.description%"
        },
        "forgejoToolkit.mcpWriteTools.submitPullReview": {
          "type": "boolean",
          "default": false,
          "description": "%config.mcpWriteTools.submitPullReview.description%"
        },
        "forgejoToolkit.mcpWriteAuditToFile": {
          "type": "boolean",
          "default": false,
          "description": "%config.mcpWriteAuditToFile.description%"
        },
        "forgejoToolkit.multiWindowLease": {
          "type": "boolean",
          "default": true,
          "description": "%config.multiWindowLease.description%"
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "forgejo-toolkit.instances",
        "label": "%mcpServerDefinitionProvider.instances.label%"
      }
    ],
    "commands": [
      {
        "command": "forgejoToolkit.openDashboard",
        "title": "%command.openDashboard.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(home)"
      },
      {
        "command": "forgejoToolkit.openOnboarding",
        "title": "%command.openOnboarding.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(book)"
      },
      {
        "command": "forgejoToolkit.openSettings",
        "title": "%command.openSettings.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(gear)"
      },
      {
        "command": "forgejoToolkit.refreshInstances",
        "title": "%command.refreshInstances.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(refresh)"
      },
      {
        "command": "forgejoToolkit.copyPermalink",
        "title": "%command.copyPermalink.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(link)"
      },
      {
        "command": "forgejoToolkit.publishToForgejo",
        "title": "%command.publishToForgejo.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "forgejoToolkit.showLog",
        "title": "%command.showLog.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(output)"
      },
      {
        "command": "forgejoToolkit.createPrFromCurrentBranch",
        "title": "%command.createPrFromCurrentBranch.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(git-pull-request-create)"
      },
      {
        "command": "forgejoToolkit.deletePullReviewComment",
        "title": "%command.deletePullReviewComment.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(trash)"
      },
      {
        "command": "forgejoToolkit.addPullReviewComment",
        "title": "%command.addPullReviewComment.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(comment)"
      },
      {
        "command": "forgejoToolkit.copyAgentsWindowMcpConfig",
        "title": "%command.copyAgentsWindowMcpConfig.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(copy)"
      },
      {
        "command": "forgejoToolkit.writeCopilotInstructions",
        "title": "%command.writeCopilotInstructions.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(copilot)"
      },
      {
        "command": "forgejoToolkit.copyPollingDiagnostics",
        "title": "%command.copyPollingDiagnostics.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(copy)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forgejoToolkit",
          "title": "Forgejo Toolkit",
          "icon": "$(repo)"
        }
      ]
    },
    "views": {
      "forgejoToolkit": [
        {
          "type": "webview",
          "id": "forgejoToolkitView",
          "name": "%view.dashboard.name%",
          "icon": "$(repo)",
          "when": "true"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "forgejoToolkit.gettingStarted",
        "title": "%walkthrough.gettingStarted.title%",
        "description": "%walkthrough.gettingStarted.description%",
        "steps": [
          {
            "id": "addInstance",
            "title": "%walkthrough.addInstance.title%",
            "description": "%walkthrough.addInstance.description%",
            "media": {
              "markdown": "./walkthrough/addInstance.md"
            }
          },
          {
            "id": "openDashboard",
            "title": "%walkthrough.openDashboard.title%",
            "description": "%walkthrough.openDashboard.description%",
            "media": {
              "markdown": "./walkthrough/openDashboard.md"
            }
          },
          {
            "id": "publishOrCreatePr",
            "title": "%walkthrough.publishOrCreatePr.title%",
            "description": "%walkthrough.publishOrCreatePr.description%",
            "media": {
              "markdown": "./walkthrough/publishOrCreatePr.md"
            }
          }
        ]
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "forgejoToolkit.deletePullReviewComment",
          "when": "false"
        },
        {
          "command": "forgejoToolkit.addPullReviewComment",
          "when": "false"
        }
      ],
      "comments/comment/context": [
        {
          "command": "forgejoToolkit.deletePullReviewComment",
          "when": "commentController == forgejo-pull-review-comments && comment =~ /^forgejo:/",
          "group": "navigation@0"
        }
      ],
      "editor/context": [
        {
          "command": "forgejoToolkit.copyPermalink",
          "when": "resourceScheme == forgejo-pr || (resourceScheme == file && forgejoToolkit.hasLinkedRepo)",
          "group": "9_cutcopypaste@5"
        },
        {
          "command": "forgejoToolkit.addPullReviewComment",
          "when": "forgejoToolkit.inPullRequestDiff",
          "group": "1_comments@0"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "forgejoToolkit.addPullReviewComment",
          "when": "forgejoToolkit.inPullRequestDiff",
          "group": "comments@0"
        }
      ],
      "view/title": [
        {
          "command": "forgejoToolkit.openDashboard",
          "when": "view == forgejoToolkitView",
          "group": "navigation@0"
        },
        {
          "command": "forgejoToolkit.openOnboarding",
          "when": "view == forgejoToolkitView",
          "group": "navigation@1"
        },
        {
          "command": "forgejoToolkit.openSettings",
          "when": "view == forgejoToolkitView",
          "group": "navigation@2"
        },
        {
          "command": "forgejoToolkit.refreshInstances",
          "when": "view == forgejoToolkitView",
          "group": "navigation@3"
        }
      ],
      "scm/title": [
        {
          "command": "forgejoToolkit.publishToForgejo",
          "when": "scmProvider == git && forgejoToolkit.hasUnpublishedRepo",
          "group": "navigation@1"
        },
        {
          "command": "forgejoToolkit.createPrFromCurrentBranch",
          "when": "scmProvider == git && forgejoToolkit.hasLinkedRepo",
          "group": "navigation@2"
        }
      ]
    }
  },
  "activationEvents": [
    "onFileSystem:cpf23333-forgejo-toolkit-repofile",
    "onFileSystem:forgejo-pr",
    "onStartupFinished",
    "onView:forgejoToolkitView"
  ],
  "engines": {
    "vscode": "^1.102.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces.description%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces.description%"
    }
  }
}
