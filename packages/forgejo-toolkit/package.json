{
  "name": "forgejo-toolkit",
  "displayName": "%displayName%",
  "version": "0.0.1",
  "description": "%description%",
  "categories": [
    "Other"
  ],
  "keywords": [
    "forgejo",
    "git",
    "gitea",
    "issues",
    "pull requests"
  ],
  "homepage": "https://codeberg.org/cpf23333/forgejo-toolkit",
  "bugs": {
    "url": "https://codeberg.org/cpf23333/forgejo-toolkit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/cpf23333/forgejo-toolkit.git"
  },
  "publisher": "your-publisher-name",
  "main": "./out/extension.js",
  "scripts": {
    "build": "node esbuild.js --production && vite build --config webview/vite.config.ts",
    "build:extension": "node esbuild.js",
    "build:webview": "vite build --config webview/vite.config.ts",
    "watch:extension": "node esbuild.js --watch",
    "watch:webview": "vite build --config webview/vite.config.ts --watch",
    "dev": "concurrently \"pnpm run watch:extension\" \"pnpm run watch:webview\"",
    "check": "tsc --noEmit && vue-tsc -p webview/tsconfig.json --noEmit",
    "test": "vitest run --config webview/vitest.config.ts && vitest run --config vitest.extension.config.ts",
    "test:webview": "vitest run --config webview/vitest.config.ts",
    "test:extension": "vitest run --config vitest.extension.config.ts",
    "test:watch": "vitest --config webview/vitest.config.ts",
    "clean": "rm -rf out node_modules",
    "package": "pnpm run build && vsce package --no-dependencies"
  },
  "dependencies": {
    "@cpf23333-forgejo-toolkit/api": "workspace:*",
    "@cpf23333-forgejo-toolkit/shared": "workspace:*",
    "@vscode/codicons": "^0.0.45",
    "easymde": "^2.21.0",
    "tributejs": "^5.1.3",
    "vue-i18n": "^10.0.7",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/vscode": "^1.85.0",
    "@types/vscode-webview": "^1.57.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vscode-elements/elements": "^2.5.1",
    "@vscode/vsce": "^3.3.2",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.32.0",
    "msw": "^2.14.6",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.5"
  },
  "l10n": "./l10n",
  "contributes": {
    "configuration": {
      "title": "Forgejo Toolkit",
      "properties": {
        "forgejoToolkit.locale": {
          "type": "string",
          "enum": [
            "en",
            "zh"
          ],
          "description": "%config.locale.description%"
        },
        "forgejoToolkit.debug": {
          "type": "boolean",
          "default": false,
          "description": "%config.debug.description%"
        },
        "forgejoToolkit.worktreeOpenMode": {
          "type": "string",
          "default": "ask",
          "enum": [
            "ask",
            "newWindow",
            "currentWindow"
          ],
          "enumDescriptions": [
            "%config.worktreeOpenMode.enumDescriptions.ask%",
            "%config.worktreeOpenMode.enumDescriptions.newWindow%",
            "%config.worktreeOpenMode.enumDescriptions.currentWindow%"
          ],
          "description": "%config.worktreeOpenMode.description%"
        },
        "forgejoToolkit.worktreeCacheDirectory": {
          "type": "string",
          "default": "",
          "description": "%config.worktreeCacheDirectory.description%"
        },
        "forgejoToolkit.notificationPollingEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.notificationPollingEnabled.description%"
        },
        "forgejoToolkit.notificationPollingInterval": {
          "type": "number",
          "default": 300,
          "minimum": 60,
          "maximum": 3600,
          "description": "%config.notificationPollingInterval.description%"
        },
        "forgejoToolkit.useMockApi": {
          "type": "boolean",
          "default": false,
          "description": "%config.useMockApi.description%"
        }
      }
    },
    "commands": [
      {
        "command": "forgejoToolkit.openDashboard",
        "title": "%command.openDashboard.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(home)"
      },
      {
        "command": "forgejoToolkit.openOnboarding",
        "title": "%command.openOnboarding.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(book)"
      },
      {
        "command": "forgejoToolkit.openSettings",
        "title": "%command.openSettings.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(gear)"
      },
      {
        "command": "forgejoToolkit.refreshInstances",
        "title": "%command.refreshInstances.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(refresh)"
      },
      {
        "command": "forgejoToolkit.copyPermalink",
        "title": "%command.copyPermalink.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(link)"
      },
      {
        "command": "forgejoToolkit.publishToForgejo",
        "title": "%command.publishToForgejo.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "forgejoToolkit.showLog",
        "title": "%command.showLog.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(output)"
      },
      {
        "command": "forgejoToolkit.createPrFromCurrentBranch",
        "title": "%command.createPrFromCurrentBranch.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(git-pull-request-create)"
      },
      {
        "command": "forgejoToolkit.deletePullReviewComment",
        "title": "%command.deletePullReviewComment.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(trash)"
      },
      {
        "command": "forgejoToolkit.addPullReviewComment",
        "title": "%command.addPullReviewComment.title%",
        "category": "Forgejo Toolkit",
        "icon": "$(comment)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forgejoToolkit",
          "title": "Forgejo Toolkit",
          "icon": "$(repo)"
        }
      ]
    },
    "views": {
      "forgejoToolkit": [
        {
          "type": "webview",
          "id": "forgejoToolkitView",
          "name": "Dashboard",
          "icon": "$(repo)",
          "when": "true"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "forgejoToolkit.gettingStarted",
        "title": "%walkthrough.gettingStarted.title%",
        "description": "%walkthrough.gettingStarted.description%",
        "steps": [
          {
            "id": "addInstance",
            "title": "%walkthrough.addInstance.title%",
            "description": "%walkthrough.addInstance.description%",
            "media": {
              "markdown": "./walkthrough/addInstance.md"
            }
          },
          {
            "id": "openDashboard",
            "title": "%walkthrough.openDashboard.title%",
            "description": "%walkthrough.openDashboard.description%",
            "media": {
              "markdown": "./walkthrough/openDashboard.md"
            }
          },
          {
            "id": "publishOrCreatePr",
            "title": "%walkthrough.publishOrCreatePr.title%",
            "description": "%walkthrough.publishOrCreatePr.description%",
            "media": {
              "markdown": "./walkthrough/publishOrCreatePr.md"
            }
          }
        ]
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "forgejoToolkit.deletePullReviewComment",
          "when": "false"
        },
        {
          "command": "forgejoToolkit.addPullReviewComment",
          "when": "false"
        }
      ],
      "comment/context": [
        {
          "command": "forgejoToolkit.deletePullReviewComment",
          "when": "comment =~ /forgejo:/",
          "group": "navigation@0"
        }
      ],
      "editor/context": [
        {
          "command": "forgejoToolkit.copyPermalink",
          "when": "resourceScheme == forgejo-pr || (resourceScheme == file && forgejoToolkit.hasLinkedRepo)",
          "group": "9_cutcopypaste@5"
        },
        {
          "command": "forgejoToolkit.addPullReviewComment",
          "when": "forgejoToolkit.inPullRequestDiff",
          "group": "1_comments@0"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "forgejoToolkit.addPullReviewComment",
          "when": "forgejoToolkit.inPullRequestDiff",
          "group": "comments@0"
        }
      ],
      "view/title": [
        {
          "command": "forgejoToolkit.openDashboard",
          "when": "view == forgejoToolkitView",
          "group": "navigation@0"
        },
        {
          "command": "forgejoToolkit.openOnboarding",
          "when": "view == forgejoToolkitView",
          "group": "navigation@1"
        },
        {
          "command": "forgejoToolkit.openSettings",
          "when": "view == forgejoToolkitView",
          "group": "navigation@2"
        },
        {
          "command": "forgejoToolkit.refreshInstances",
          "when": "view == forgejoToolkitView",
          "group": "navigation@3"
        }
      ],
      "scm/title": [
        {
          "command": "forgejoToolkit.publishToForgejo",
          "when": "scmProvider == git",
          "group": "navigation@1"
        },
        {
          "command": "forgejoToolkit.createPrFromCurrentBranch",
          "when": "scmProvider == git && forgejoToolkit.hasLinkedRepo",
          "group": "navigation@2"
        }
      ]
    }
  },
  "activationEvents": [
    "onFileSystem:cpf23333-forgejo-toolkit-repofile",
    "onFileSystem:forgejo-pr",
    "onView:forgejoToolkitView"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "packageManager": "pnpm@11.18.0"
}
