{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-extension",
      "type": "shell",
      "command": "pnpm run build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "watch-extension",
      "type": "shell",
      "command": "pnpm run watch:extension",
      "group": "build",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": ".*",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[extension\\] watching\\.\\.\\.$",
          "endsPattern": "^\\[extension\\] build complete$"
        }
      }
    },
    {
      "label": "watch-webview",
      "type": "shell",
      "command": "pnpm run watch:webview",
      "group": "build",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*building for production.*$",
          "endsPattern": "^.*built in.*$"
        }
      }
    }
  ]
}
