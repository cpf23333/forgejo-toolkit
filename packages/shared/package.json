{
  "name": "@cpf23333-forgejo-toolkit/shared",
  "version": "0.0.1",
  "description": "Shared utilities for Forgejo Toolkit packages",
  "license": "MIT",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    "./request": {
      "types": "./src/request/index.ts",
      "default": "./src/request/index.ts"
    },
    "./webview/messages": {
      "types": "./src/webview/messages.ts",
      "default": "./src/webview/messages.ts"
    },
    "./git/url": {
      "types": "./src/git/url.ts",
      "default": "./src/git/url.ts"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt ."
  },
  "devDependencies": {
    "msw": "^2.14.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
